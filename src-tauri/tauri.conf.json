{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "pokemon-choose-you",
  "version": "1.0.0",
  "identifier": "com.jotsai.pokemonchooseyou",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build && node scripts/prepare-pk-cli.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "就决定是你了",
        "url": "index.html",
        "width": 980,
        "height": 700,
        "minWidth": 760,
        "minHeight": 540
      },
      {
        "label": "pet",
        "title": "pet",
        "url": "pet.html",
        "width": 300,
        "height": 330,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "nsis",
      "dmg",
      "appimage",
      "deb",
      "rpm"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/pk"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Jo0OCTsai/pokemon-choose-you/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg1NEZEN0YyMENBQ0Y5M0EKUldRNithd004dGRQaGFvK3oyN3Voa3gwT0FQeVAzT1Y1Rjg1N05DZTdadkpZZjZ0M1didnNUQlcK"
    }
  }
}
