{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "pokemon-knock",
  "version": "0.1.0",
  "identifier": "com.joeca.pokemonknock",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "宝可梦来敲门",
        "url": "index.html",
        "width": 980,
        "height": 700,
        "minWidth": 760,
        "minHeight": 540
      },
      {
        "label": "pet",
        "title": "pet",
        "url": "pet.html",
        "width": 300,
        "height": 330,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
