  "kind": "cli_envelope",
  "name": "dispatch",
  "invocations": [
    { "argv": ["task", "create", "--title", "修登录断点"] },
    { "argv": ["task", "create", "--title", "补回归用例"] },
    { "argv": ["dispatch", "start", "--task", "1"] },
